NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/mern_taskmanager?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d

# Khalti Payment
KHALTI_LIVE_SECRET_KEY=key_from_khalti
KHALTI_URL=https://dev.khalti.com/api/v2/
KHALTI_AFTER_PAYMENT_URL=http://localhost:5173/khalti-payment

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASSWORD="your_gmail_app_password"
SMTP_FROM_ADDRESS=example@gmail.com

# Frontend URL (for links in emails)
CLIENT_URL=http://localhost:3000
